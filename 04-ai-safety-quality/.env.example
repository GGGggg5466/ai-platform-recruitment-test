# --- Core ---
APP_ENV=dev
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=default
DATA_DIR=./data

# --- Upstream endpoints (B plan: shared, no api_key) ---
# LLM (OpenAI-compatible chat completions)
LLM_BASE_URL=https://ws-02.wade0426.me
LLM_CHAT_PATH=/v1/chat/completions
LLM_MODEL=/models/Qwen3-30B-A3B-Instruct-2507-FP8

# VLM (OpenAI-compatible chat completions)
VLM_BASE_URL=https://ws-05.huannago.com
VLM_CHAT_PATH=/v1/chat/completions
VLM_MODEL=Qwen3-VL-8B-Instruct-BF16.gguf

# Embedding
EMBED_URL=https://ws-04.wade0426.me/embed
EMBED_MODEL=Qwen3-Embedding-8B
EMBED_DIM=4096

# Similarity (optional)
SIMILARITY_URL=https://ws-04.wade0426.me/similarity

# --- Timeouts / retries ---
EMBED_TIMEOUT_S=10
LLM_TIMEOUT_S=30
VLM_TIMEOUT_S=45
RETRY_MAX=1
RETRY_BACKOFF_S=0.8

# --- Policy thresholds ---
RISK_BLOCK_THRESHOLD=0.8
CONFIDENCE_HITL_THRESHOLD=0.4

# --- Langfuse (optional) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT=
