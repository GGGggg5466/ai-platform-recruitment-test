# Redis
REDIS_URL=redis://redis:6379/0

# Gateway
JWT_SECRET=dev_secret_change_me
REQUEST_TIMEOUT=60
RATE_LIMIT_RPM=60
MEMORY_TTL_SECONDS=3600

# LiteLLM
# master key for /key/generate (virtual key management)
LITELLM_MASTER_KEY=sk-local-master-123456

# Upstream (OpenAI-compatible /v1/chat/completions)
# For standalone demo, keep using mock_upstream:
UPSTREAM_OLM_BASE_URL=http://mock_upstream:9100
UPSTREAM_LLM_BASE_URL=http://mock_upstream:9100
UPSTREAM_VLM_BASE_URL=http://mock_upstream:9100

# Upstream does not require API key in this HW, but LiteLLM's OpenAI adapter expects a value.
UPSTREAM_DUMMY_KEY=EMPTY

# /chat optional model:
# If DEFAULT_MODEL empty, /chat without model keeps old demo behavior.
# If you want /chat always go through LiteLLM by default, set DEFAULT_MODEL.
DEFAULT_MODEL=/models/Qwen3-30B-A3B-Instruct-2507-FP8

# Model names (client-facing) used by LiteLLM allowlist + bootstrap
# (must match litellm_config.yaml model_name values)
OLM_MODEL_NAME=allenai/olmOCR-2-7B-1025-FP8
LLM_MODEL_NAME=/models/Qwen3-30B-A3B-Instruct-2507-FP8
VLM_MODEL_NAME=gemma-3-27b-it

